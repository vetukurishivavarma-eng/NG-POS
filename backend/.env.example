# Copy to .env and fill in.

NODE_ENV=development
PORT=4000

# PostgreSQL. Local Docker default shown; for hosted use Neon or Supabase.
DATABASE_URL="postgresql://ngpos:ngpos@localhost:5433/ngpos?schema=public"

# Used by `prisma migrate` only. On serverless Postgres set this to the DIRECT
# (non-pooled) connection string — migrations through PgBouncer are unreliable,
# because it multiplexes sessions and the migration advisory lock needs one.
# Locally there is no pooler, so it is simply the same URL again.
DIRECT_URL="postgresql://ngpos:ngpos@localhost:5433/ngpos?schema=public"

# Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN=30d

# Comma-separated origins, or * to allow any.
# Native apps send no Origin header, so this only constrains browser clients.
CORS_ORIGINS=*

# The shops' timezone. Reporting days and receipt-number days are cut here, not
# on the server clock — a UTC container would otherwise push evening sales onto
# the next day's Z-report.
REPORT_TIMEZONE=Africa/Lusaka

# Nightly day-report snapshot. Set CRON_ENABLED=false on every instance but one
# if you run more than one container, or they race on the same rows.
CRON_ENABLED=true
DAILY_REPORT_CRON=5 21 * * *
DAILY_REPORT_SEAL_CRON=20 0 * * *

# --- Forgotten passwords -----------------------------------------------------
# Reset requests are mailed to ONE administrator, not to the address that asked.
# Shop staff are created with internal addresses (cashier@ngpos.local) that no
# mailbox answers, and mailing a reset code to an address an attacker controls
# is exactly the hole this avoids. The admin reads the one-time code back to the
# person in front of them.
#
# Leave PASSWORD_RESET_NOTIFY_EMAIL unset to turn the feature off — the endpoint
# then says so plainly instead of accepting requests nobody will read.
PASSWORD_RESET_NOTIFY_EMAIL=
PASSWORD_RESET_TTL_MINUTES=30
APP_NAME="NG POS"

# Mail needs MAIL_FROM, the address above, and ONE of the two transports below.
# With neither set in development the mail is printed to the console instead, so
# the flow is testable without a mail server.

# Transport 1: Resend's HTTP API. Preferred on Render, whose free plan blocks
# outbound SMTP ports (25/465/587) by dropping the packets — nodemailer then
# hangs rather than failing. This goes over HTTPS on 443 and is unaffected.
# Until a sending domain is verified with Resend, MAIL_FROM must be
# onboarding@resend.dev and mail only reaches the account owner's own address.
RESEND_API_KEY=
MAIL_FROM="NG POS <onboarding@resend.dev>"

# Transport 2: SMTP, used only when RESEND_API_KEY is empty. HOST/USER/PASSWORD
# must all be set. Gmail: use an App Password
# (https://myaccount.google.com/apppasswords), not the account password — and
# never commit it.
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS on 465, false for STARTTLS on 587.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Legacy alias for MAIL_FROM, still honoured so an SMTP-only deployment that
# predates Resend keeps working without being re-typed.
SMTP_FROM=

# How much of a line a CASHIER may discount, as a percentage. Managers and
# admins are unlimited. Uncapped, "discount" is just a price override by another
# name — a cashier could take any item to zero. Set to 0 to require a manager
# for every discount.
MAX_CASHIER_DISCOUNT_PERCENT=10
