# Copy to .env and fill in.

NODE_ENV=development
PORT=4000

# PostgreSQL. Local Docker default shown; for hosted use Neon/Supabase/Railway.
DATABASE_URL="postgresql://ngpos:ngpos@localhost:5433/ngpos?schema=public"

# Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN=30d

# Comma-separated origins, or * to allow any.
# Native apps send no Origin header, so this only constrains browser clients.
CORS_ORIGINS=*

# The shops' timezone. Reporting days and receipt-number days are cut here, not
# on the server clock — a UTC container would otherwise push evening sales onto
# the next day's Z-report.
REPORT_TIMEZONE=Africa/Lusaka

# Nightly day-report snapshot. Set CRON_ENABLED=false on every instance but one
# if you run more than one container, or they race on the same rows.
CRON_ENABLED=true
DAILY_REPORT_CRON=5 21 * * *
DAILY_REPORT_SEAL_CRON=20 0 * * *

# How much of a line a CASHIER may discount, as a percentage. Managers and
# admins are unlimited. Uncapped, "discount" is just a price override by another
# name — a cashier could take any item to zero. Set to 0 to require a manager
# for every discount.
MAX_CASHIER_DISCOUNT_PERCENT=10
