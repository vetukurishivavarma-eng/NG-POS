// NG POS data model.
//
// Shapes follow the contract the mobile app already speaks (see the app's
// SPEC.md), with two deliberate improvements over the system it replaces:
//   1. Transaction line items are relational, not a JSON blob, so analytics can
//      be computed in SQL instead of in application code.
//   2. Sales carry a client-supplied idempotency key, so an offline sale that is
//      replayed after a lost response cannot be recorded twice.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

  // Serverless Postgres (Neon, Supabase) hands out two connection strings: a
  // pooled one through PgBouncer for queries, and a direct one. Migrations must
  // not go through the pooler — it multiplexes sessions, so the advisory lock
  // and DDL that `prisma migrate` relies on are unreliable there.
  //
  // Prisma errors if this is unset, so it must be defined everywhere — locally
  // there is no pooler, so set it to the same value as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

enum Role {
  ORG_ADMIN
  STORE_MANAGER
  CASHIER
}

enum TaxType {
  exempt
  vat
}

enum TransactionType {
  sale
  refund
  credit_note
}

enum TransactionStatus {
  pending
  completed
  refunded
  voided
}

enum PaymentMethod {
  cash
  card
  mobile
}

enum TransferStatus {
  pending
  in_transit
  completed
  cancelled
}

enum StockMovementType {
  purchase
  sale
  adjustment
  transfer_in
  transfer_out
  refund
}

/// How much of a supplier's invoice has been settled. Derived from the payments
/// against it, but stored so "what do we still owe?" is one indexed query
/// rather than a sum over every payment row in the organisation.
enum SupplierInvoiceStatus {
  unpaid
  partial
  paid
}

/// Deliberately separate from `PaymentMethod`, which is what a *customer* can
/// tender at the till. Money going out to a supplier moves in different ways —
/// nobody pays a wholesaler by swiping a card at the counter — and widening the
/// till's enum to fit would let those values be offered to a cashier.
enum SupplierPaymentMethod {
  cash
  bank_transfer
  mobile
  cheque
  card
  other
}

model Organization {
  id                String   @id @default(uuid())
  name              String
  slug              String   @unique
  logoBase64        String?  @map("logo_base64")
  invoiceLogoBase64 String?  @map("invoice_logo_base64")
  vatRate           Decimal  @default(0.16) @map("vat_rate") @db.Decimal(5, 4)
  currencySymbol    String   @default("K") @map("currency_symbol")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  users            User[]
  stores           Store[]
  products         Product[]
  warehouses       Warehouse[]
  transactions     Transaction[]
  transfers        Transfer[]
  dailyReports     DailyReport[]
  suppliers        Supplier[]
  supplierInvoices SupplierInvoice[]

  @@map("organizations")
}

model User {
  id                String   @id @default(uuid())
  organizationId    String   @map("organization_id")
  email             String   @unique
  passwordHash      String   @map("password_hash")
  fullName          String   @map("full_name")
  role              Role     @default(CASHIER)
  /// Empty means "all stores in the organization".
  assignedStores    String[] @default([]) @map("assigned_stores")
  isActive          Boolean  @default(true) @map("is_active")
  /// Tokens issued before this moment are refused, so changing or resetting a
  /// password logs out every device that still holds the old one.
  passwordChangedAt DateTime @default(now()) @map("password_changed_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  passwordResets PasswordResetRequest[]
  deviceSessions DeviceSession[]

  @@index([organizationId])
  @@map("users")
}

/// One till, one account, one device.
///
/// Staff share a counter and a WhatsApp group, and a password travels faster
/// than either. Without this, one cashier's credentials run on four phones and
/// every sale, refund and stock correction they make is attributable to a
/// person rather than to a device anyone could be holding.
///
/// The rule is enforced at sign-in: a second device is refused while one is
/// still active, and an administrator releases it from the Devices screen. A
/// password reset also releases everything — otherwise an administrator who
/// lost their phone would have nobody above them to unlock it.
model DeviceSession {
  id             String @id @default(uuid())
  userId         String @map("user_id")
  organizationId String @map("organization_id")
  /// Generated by the app and kept in SecureStore. A reinstall deliberately
  /// looks like a new device — the old install's token is gone with it, and
  /// pretending otherwise would let a wiped phone keep its claim.
  deviceId       String @map("device_id")
  /// What the admin reads in the list, e.g. "Samsung SM-A125F".
  deviceName     String @map("device_name")
  platform       String
  appVersion     String? @map("app_version")

  /// Refreshed at most every few minutes, not on every request — this is for
  /// an admin deciding whether a device is still in use, not an audit trail.
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  lastIp     String?  @map("last_ip")
  createdAt  DateTime @default(now()) @map("created_at")

  /// Set once and never cleared: releasing a device ends that session for good,
  /// and the next sign-in on it starts a new row. Keeping the old one is what
  /// lets an admin see that a device was removed, by whom and why.
  revokedAt     DateTime? @map("revoked_at")
  revokedById   String?   @map("revoked_by_id")
  revokedReason String?   @map("revoked_reason")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One row per account per physical device; signing in again on the same
  /// device reuses it rather than piling up history nobody reads.
  @@unique([userId, deviceId])
  @@index([userId])
  @@index([organizationId])
  @@index([organizationId, revokedAt])
  @@map("device_sessions")
}

/// A staff member asked to have their password reset. The one-time code is
/// stored only as a bcrypt hash — a leaked database row must not be usable as a
/// reset code. The plaintext exists once, in the mail sent to the organisation's
/// administrator, who is the one who vouches for the request.
model PasswordResetRequest {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  /// Wrong guesses against this code; the code is burned once it gets too high.
  attempts   Int       @default(0)
  /// Recorded for the notification mail so an admin can judge the request.
  requestIp  String    @default("") @map("request_ip")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_requests")
}

model Store {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  name           String
  code           String
  street         String    @default("")
  city           String    @default("")
  province       String    @default("")
  postalCode     String    @default("") @map("postal_code")
  country        String    @default("Zambia")
  latitude       Float?
  longitude      Float?
  phone          String    @default("")
  email          String    @default("")
  isActive       Boolean   @default(true) @map("is_active")
  lastSyncAt     DateTime? @map("last_sync_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventory        Inventory[]
  prices           StorePrice[]
  transactions     Transaction[]
  receiptCounters  ReceiptCounter[]
  stockMovements   StockMovement[]
  transfersOut     Transfer[]        @relation("TransferFrom")
  transfersIn      Transfer[]        @relation("TransferTo")
  dailyReports     DailyReport[]
  supplierInvoices SupplierInvoice[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("stores")
}

model Product {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?
  sku            String
  barcode        String?
  brand          String?
  category       String?
  costPrice      Decimal  @default(0) @map("cost_price") @db.Decimal(12, 2)
  sellingPrice   Decimal  @default(0) @map("selling_price") @db.Decimal(12, 2)
  taxType        TaxType  @default(exempt) @map("tax_type")
  unit           String?
  variants       Json     @default("[]")
  isActive       Boolean  @default(true) @map("is_active")
  imageBase64    String?  @map("image_base64")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventory            Inventory[]
  prices               StorePrice[]
  items                TransactionItem[]
  warehouseStock       WarehouseStock[]
  stockMovements       StockMovement[]
  transferItems        TransferItem[]
  supplierInvoiceItems SupplierInvoiceItem[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([barcode])
  @@map("products")
}

model Inventory {
  id           String   @id @default(uuid())
  storeId      String   @map("store_id")
  productId    String   @map("product_id")
  quantity     Decimal  @default(0) @db.Decimal(12, 3)
  reorderLevel Decimal  @default(10) @map("reorder_level") @db.Decimal(12, 3)
  updatedAt    DateTime @updatedAt @map("updated_at")

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, productId])
  @@index([storeId])
  @@map("inventory")
}

/// Per-store price override. Absent means the product's default price applies.
model StorePrice {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  productId String   @map("product_id")
  price     Decimal  @db.Decimal(12, 2)
  updatedAt DateTime @updatedAt @map("updated_at")

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, productId])
  @@map("store_prices")
}

model Transaction {
  id              String            @id @default(uuid())
  organizationId  String            @map("organization_id")
  storeId         String            @map("store_id")
  receiptNumber   String            @unique @map("receipt_number")
  transactionType TransactionType   @default(sale) @map("transaction_type")
  status          TransactionStatus @default(completed)
  subtotal        Decimal           @default(0) @db.Decimal(12, 2)
  discountAmount  Decimal           @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount       Decimal           @default(0) @map("tax_amount") @db.Decimal(12, 2)
  total           Decimal           @default(0) @db.Decimal(12, 2)
  cashierId       String?           @map("cashier_id")
  cashierName     String            @default("") @map("cashier_name")
  customerName    String?           @map("customer_name")
  customerPhone   String?           @map("customer_phone")
  notes           String            @default("")
  /// Idempotency key generated on the device before the sale is queued.
  /// Unique, so replaying a queued sale after a lost response is a no-op.
  clientReference String?           @unique @map("client_reference")
  /// Set on the refund/credit note that reverses an earlier sale.
  reversesId      String?           @map("reverses_id")
  voidedAt        DateTime?         @map("voided_at")
  voidReason      String?           @map("void_reason")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  cashier      User?             @relation(fields: [cashierId], references: [id], onDelete: SetNull)
  items        TransactionItem[]
  payments     Payment[]
  reverses     Transaction?      @relation("Reversal", fields: [reversesId], references: [id], onDelete: SetNull)
  reversedBy   Transaction[]     @relation("Reversal")

  @@index([storeId, createdAt])
  @@index([organizationId, createdAt])
  @@map("transactions")
}

model TransactionItem {
  id             String  @id @default(uuid())
  transactionId  String  @map("transaction_id")
  productId      String? @map("product_id")
  /// Denormalised so a historical receipt survives the product being renamed.
  productName    String  @map("product_name")
  sku            String  @default("")
  brand          String?
  quantity       Decimal @db.Decimal(12, 3)
  unitPrice      Decimal @map("unit_price") @db.Decimal(12, 2)
  costPrice      Decimal @default(0) @map("cost_price") @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxType        TaxType @default(exempt) @map("tax_type")
  taxAmount      Decimal @default(0) @map("tax_amount") @db.Decimal(12, 2)
  lineTotal      Decimal @map("line_total") @db.Decimal(12, 2)

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product     Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([transactionId])
  @@index([productId])
  @@map("transaction_items")
}

model Payment {
  id            String        @id @default(uuid())
  transactionId String        @map("transaction_id")
  method        PaymentMethod
  amount        Decimal       @db.Decimal(12, 2)
  reference     String?

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@map("payments")
}

/// Serialises receipt numbering per store per day.
/// `STORECODE-YYYYMMDD-NNNNNN` must never collide, including when several
/// devices sync queued offline sales at the same moment.
model ReceiptCounter {
  id       String @id @default(uuid())
  storeId  String @map("store_id")
  /// Local date as YYYYMMDD.
  day      String
  sequence Int    @default(0)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, day])
  @@map("receipt_counters")
}

/// A frozen end-of-day Z-report, written by the nightly job.
///
/// The figures could always be recomputed from `transactions`, but a snapshot
/// is what reconciles against the cash that was actually counted that night:
/// it cannot drift when an old sale is later voided, and it survives the
/// transaction table being archived.
model DailyReport {
  id               String   @id @default(uuid())
  organizationId   String   @map("organization_id")
  storeId          String   @map("store_id")
  /// Local calendar date as YYYY-MM-DD, matching the receipt-number day.
  date             String
  transactionCount Int      @default(0) @map("transaction_count")
  /// Net of refunds — the same figure the live endpoint calls `gross_total`.
  grossTotal       Decimal  @default(0) @map("gross_total") @db.Decimal(12, 2)
  taxTotal         Decimal  @default(0) @map("tax_total") @db.Decimal(12, 2)
  refundTotal      Decimal  @default(0) @map("refund_total") @db.Decimal(12, 2)
  cashTotal        Decimal  @default(0) @map("cash_total") @db.Decimal(12, 2)
  cardTotal        Decimal  @default(0) @map("card_total") @db.Decimal(12, 2)
  mobileTotal      Decimal  @default(0) @map("mobile_total") @db.Decimal(12, 2)
  /// `[{ name, quantity, total }]`, best sellers first.
  topItems         Json     @default("[]") @map("top_items")
  /// True once the day is over and the job has sealed it. An intraday snapshot
  /// is written unsealed so a manager can print a mid-day figure.
  finalized        Boolean  @default(false)
  generatedAt      DateTime @default(now()) @map("generated_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, date])
  @@index([organizationId, date])
  @@map("daily_reports")
}

model StockMovement {
  id        String            @id @default(uuid())
  storeId   String            @map("store_id")
  productId String            @map("product_id")
  type      StockMovementType
  /// Signed: negative for sales and transfers out.
  quantity  Decimal           @db.Decimal(12, 3)
  balance   Decimal           @db.Decimal(12, 3)
  reference String?
  note      String?
  userId    String?           @map("user_id")
  createdAt DateTime          @default(now()) @map("created_at")

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@map("stock_movements")
}

model Warehouse {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  code           String
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stock        WarehouseStock[]

  @@unique([organizationId, code])
  @@map("warehouses")
}

model WarehouseStock {
  id          String   @id @default(uuid())
  warehouseId String   @map("warehouse_id")
  productId   String   @map("product_id")
  quantity    Decimal  @default(0) @db.Decimal(12, 3)
  updatedAt   DateTime @updatedAt @map("updated_at")

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId])
  @@map("warehouse_stock")
}

model Transfer {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  reference      String         @unique
  fromStoreId    String?        @map("from_store_id")
  toStoreId      String?        @map("to_store_id")
  status         TransferStatus @default(pending)
  notes          String         @default("")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromStore    Store?         @relation("TransferFrom", fields: [fromStoreId], references: [id], onDelete: SetNull)
  toStore      Store?         @relation("TransferTo", fields: [toStoreId], references: [id], onDelete: SetNull)
  items        TransferItem[]

  @@index([organizationId])
  @@map("transfers")
}

model TransferItem {
  id         String  @id @default(uuid())
  transferId String  @map("transfer_id")
  productId  String  @map("product_id")
  quantity   Decimal @db.Decimal(12, 3)

  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@map("transfer_items")
}

/// A wholesaler the shop buys from.
model Supplier {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  contactName    String   @default("") @map("contact_name")
  phone          String   @default("")
  email          String   @default("")
  address        String   @default("")
  /// Free text: agreed terms, account number, delivery days.
  notes          String   @default("")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices     SupplierInvoice[]

  // One row per supplier per organisation, so the same wholesaler cannot end up
  // entered three times with three separate outstanding balances.
  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("suppliers")
}

/// A delivery from a supplier, priced. Posting one is what puts stock on the
/// shelf: the goods, the paperwork reference and the money owed are the same
/// event, and recording them separately is how a shop ends up with stock it
/// cannot account for.
///
/// `amountPaid` is maintained alongside the payment rows rather than summed on
/// read. The balance is asked for on every list screen, and a stored figure can
/// be constrained — a payment is refused if it would take the invoice past its
/// total, which a sum computed after the fact cannot prevent.
model SupplierInvoice {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  supplierId     String    @map("supplier_id")
  /// The store the goods were received into; stock lands here.
  storeId        String    @map("store_id")
  /// The supplier's own invoice number, as printed on the paper.
  invoiceNumber  String    @map("invoice_number")
  invoiceDate    DateTime  @map("invoice_date")
  dueDate        DateTime? @map("due_date")

  subtotal       Decimal @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @map("tax_amount") @db.Decimal(12, 2)
  /// Delivery, handling — anything on the invoice that is not a stock line.
  otherCharges   Decimal @default(0) @map("other_charges") @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(12, 2)
  total          Decimal @default(0) @db.Decimal(12, 2)
  amountPaid     Decimal @default(0) @map("amount_paid") @db.Decimal(12, 2)

  status        SupplierInvoiceStatus @default(unpaid)
  notes         String                @default("")
  createdById   String?               @map("created_by_id")
  createdByName String                @default("") @map("created_by_name")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier     Supplier              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  store        Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items        SupplierInvoiceItem[]
  payments     SupplierPayment[]

  // Entering the same paper invoice twice would double the stock and double the
  // debt. The database refuses it rather than the form remembering to.
  @@unique([organizationId, supplierId, invoiceNumber])
  @@index([organizationId, status])
  @@index([storeId, invoiceDate])
  @@map("supplier_invoices")
}

model SupplierInvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String  @map("invoice_id")
  productId   String? @map("product_id")
  /// Denormalised so the invoice still reads correctly after a rename.
  productName String  @map("product_name")
  sku         String  @default("")
  quantity    Decimal @db.Decimal(12, 3)
  unitCost    Decimal @map("unit_cost") @db.Decimal(12, 2)
  lineTotal   Decimal @map("line_total") @db.Decimal(12, 2)

  invoice SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([productId])
  @@map("supplier_invoice_items")
}

/// One instalment against an invoice. Part-payments are the normal case here —
/// stock is taken on credit and settled over weeks — so each one is its own row
/// with its own reference, and the running balance is the invoice total minus
/// their sum.
model SupplierPayment {
  id        String                @id @default(uuid())
  invoiceId String                @map("invoice_id")
  amount    Decimal               @db.Decimal(12, 2)
  method    SupplierPaymentMethod @default(cash)
  /// Cheque number, transfer reference, mobile-money code.
  reference String                @default("")
  note      String                @default("")
  paidAt    DateTime              @default(now()) @map("paid_at")
  userId    String?               @map("user_id")
  userName  String                @default("") @map("user_name")
  createdAt DateTime              @default(now()) @map("created_at")

  invoice SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("supplier_payments")
}
